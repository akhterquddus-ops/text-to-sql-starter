# Copy to .env and adjust. Never commit your real .env.

# Which model to use: "ollama" (local, default) or "openai" (any OpenAI-compatible API)
LLM_PROVIDER=ollama

# Ollama (local, free, nothing leaves your machine)
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_URL=http://localhost:11434

# OpenAI-compatible API (OpenAI, Azure OpenAI, Groq, LM Studio, vLLM...)
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Optional
# SQLASSIST_DB=data/demo.db
# SQLASSIST_SEMANTIC_LAYER=semantic_layer.yaml
# SQLASSIST_MAX_ATTEMPTS=3
# SQLASSIST_ROW_LIMIT=1000
# SQLASSIST_QUERY_TIMEOUT=10
